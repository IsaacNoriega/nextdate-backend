type Query {
    ping: String!
    profileByUserId(userId: ID!) : Profile
    nearbyProfiles(longitude: Float!, latitude: Float!, radiusInKm: Float!) : [Profile!]!
}

type Mutation {
    registerUser(input: RegisterUserInput!) : User
    login(input: LoginInput!) : LoginResult
    requestPasswordReset(email: String!) : Boolean!
    resetPassword(input: ResetPasswordInput!) : Boolean!
    createProfile(input: CreateProfileInput!) : Profile!
    updateProfile(input: UpdateProfileInput!) : Profile!
}

input ResetPasswordInput {
    token: String!
    newPassword: String!
}

input LoginInput {
    email: String!
    password: String!
}

type LoginResult {
    user: User!
    token: String!
}

input RegisterUserInput {
    email: String!
    password: String!
}

type User {
    id: ID!
    email: String!
    active: Boolean!
}


type Profile {
    id: ID!
    userId: ID!
    username: String!
    birthdate: String!
    gender: Gender!
    bio: String
    latitude: Float!
    longitude: Float!
    active: Boolean!
}



input CreateProfileInput {
    userId: ID!
    username: String!
    birthdate: String! #Formato: "1998-10-20"
    gender: Gender!
    bio: String
    latitude: Float!
    longitude: Float!
}

input UpdateProfileInput {
    id: ID!
    userId: ID!
    username: String
    birthdate: String
    gender: Gender
    bio: String
    latitude: Float
    longitude: Float
}

enum Gender {
    MALE
    FEMALE
    OTHER
}