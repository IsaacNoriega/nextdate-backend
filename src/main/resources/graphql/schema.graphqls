type Query {
    ping: String!
    profileByUserId(userId: ID!) : Profile
    nearbyProfiles(longitude: Float!, latitude: Float!, radiusInKm: Float!) : [Profile!]!
    placeById(id: ID!) : Place
    nearbyPlaces(longitude: Float!, latitude: Float!, radiusInKm: Float! , category: PlaceCategory) : [Place!]!
    itineraryById(id: ID!) : Itinerary
    itinerariesByUserId(userId: ID!) : [Itinerary!]!
}

type Mutation {
    registerUser(input: RegisterUserInput!) : User
    login(input: LoginInput!) : LoginResult
    requestPasswordReset(email: String!) : Boolean!
    resetPassword(input: ResetPasswordInput!) : Boolean!
    createProfile(input: CreateProfileInput!) : Profile!
    updateProfile(input: UpdateProfileInput!) : Profile!
    createPlace(input: CreatePlaceInput!) : Place!
    updatePlace(input: UpdatePlaceInput!) : Place!
    createItinerary(input: CreateItineraryInput!) : Itinerary!
}

input ResetPasswordInput {
    token: String!
    newPassword: String!
}

input LoginInput {
    email: String!
    password: String!
}

type LoginResult {
    user: User!
    token: String!
}

input RegisterUserInput {
    email: String!
    password: String!
}

type User {
    id: ID!
    email: String!
    active: Boolean!
}


type Profile {
    id: ID!
    userId: ID!
    username: String!
    birthdate: String!
    gender: Gender!
    bio: String
    latitude: Float!
    longitude: Float!
    active: Boolean!
    dietaryPreference: DietaryPreference!
    preferredPriceRange: PriceRange!
    interests: [PlaceCategory!]!
}



input CreateProfileInput {
    userId: ID!
    username: String!
    birthdate: String! #Formato: "1998-10-20"
    gender: Gender!
    bio: String
    latitude: Float!
    longitude: Float!
    dietaryPreference: DietaryPreference!
    preferredPriceRange: PriceRange!
    interests: [PlaceCategory!]!
}

input UpdateProfileInput {
    id: ID!
    userId: ID!
    username: String
    birthdate: String
    gender: Gender
    bio: String
    latitude: Float
    longitude: Float
    dietaryPreference: DietaryPreference
    preferredPriceRange: PriceRange
    interests: [PlaceCategory!]
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum PlaceCategory {
    FOOD_DRINK
    CULTURE
    NATURE
    ENTERTAINMENT
    SHOPPING
    SPORTS
    OTHER
}

enum PriceRange {
    CHEAP
    MODERATE
    EXPENSIVE
    LUXURY
}

type Place {
    id: ID!
    name: String!
    description: String
    category: PlaceCategory!
    priceRange: PriceRange!
    address: String
    latitude: Float!
    longitude: Float!
    active: Boolean!
    createdAt: String!
}

input CreatePlaceInput {
    name: String!
    description: String
    category: PlaceCategory!
    priceRange: PriceRange!
    address: String
    latitude: Float!
    longitude: Float!
}

input UpdatePlaceInput {
    id: ID!
    name: String
    description: String
    category: PlaceCategory
    priceRange: PriceRange
    address: String
    latitude: Float
    longitude: Float
    active: Boolean
}

enum DietaryPreference {
    NONE
    VEGETARIAN
    VEGAN
    GLUTEN_FREE
    DAIRY_FREE
    PESCATARIAN
    OTHER
}

type Itinerary {
    id: ID!
    userId: ID!
    title: String!
    description: String
    totalCost: Float!
    active: Boolean!
    createdAt: String!
    items: [ItineraryItem!]!
}

type ItineraryItem {
    id: ID!
    place: Place!
    sequenceOrder: Int!
    durationInMinutes: Int!
    notes: String
    transportToNext: TransportType!
    transitTimeToNext: Int!
}

enum TransportType {
    WALKING
    DRIVING
    TRANSIT
    CYCLING
    NONE
}

input CreateItineraryInput {
    userId: ID!
    title: String!
    description: String
    totalCost: Float!
    items: [CreateItineraryItemInput!]!
}

input CreateItineraryItemInput {
    placeId: ID!
    sequenceOrder: Int!
    durationInMinutes: Int
    notes: String
    transportToNext: TransportType
    transitTimeToNext: Int
}
